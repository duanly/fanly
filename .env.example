# ===== 复制成 .env 后填写，.env 不要提交到 git =====

# ===== 镜像 =====
# 镜像仓库地址 + 命名空间。GHCR 用 ghcr.io/<你的 GitHub 用户名>，
# 以后换阿里云 ACR 改成 registry.cn-xxx.aliyuncs.com/<命名空间> 即可
IMAGE_PREFIX=ghcr.io/duanly
# 要跑哪个版本：latest 跟随 main，回滚时换成 sha-xxxxxxx
IMAGE_TAG=latest

# 已备案的域名，不带 http://
DOMAIN=fanli.example.com
# Let's Encrypt 续期通知邮箱
ACME_EMAIL=you@example.com

# JWT 密钥，随便一串长随机字符串
# 生成：openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# 数据库
DB_NAME=fanly
DB_USER=fanly
DB_PASS=CHANGE_ME
DB_ROOT_PASS=CHANGE_ME_TOO

# Redis
REDIS_PASS=CHANGE_ME_AS_WELL

# 首次部署设 true 让 TypeORM 自动建表，建完立刻改回 false
DB_SYNC=true
# 是否暴露 /docs 接口文档，上线建议 false
ENABLE_DOCS=false

# ===== CPS 渠道 =====
# mock=本地假数据 / aggregator=聚合服务商
CPS_PROVIDER=mock

AGG_BASE_URL=
AGG_API_KEY=

PDD_CLIENT_ID=
PDD_CLIENT_SECRET=
PDD_PID=

JD_APP_KEY=
JD_APP_SECRET=
JD_SITE_ID=

TB_APP_KEY=
TB_APP_SECRET=
TB_ADZONE_ID=

DY_APP_KEY=
DY_APP_SECRET=
