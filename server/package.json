{
  "name": "fanly-server",
  "version": "0.1.0",
  "description": "CPS 返利导购平台服务端",
  "scripts": {
    "build": "nest build -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "nest start",
    "dev": "nest start --watch",
    "seed": "ts-node -r tsconfig-paths/register src/seed.ts",
    "simulate": "ts-node -r tsconfig-paths/register src/simulate.ts",
    "seed:prod": "node dist/seed.js",
    "test:parse": "ts-node -r tsconfig-paths/register test/share-content.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/typeorm": "^10.0.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dayjs": "^1.11.13",
    "mysql2": "^3.11.5",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "better-sqlite3": "^11.7.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.5",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}