# ── 本地验证 / 域名未备案阶段：纯 HTTP，不签证书 ──────────────
:80 {
    encode zstd gzip

    handle /api/* {
        reverse_proxy server:3000
    }
    # 客服 IM 的 Socket.IO，漏了实时推送就全失效
    handle /socket.io/* {
        reverse_proxy server:3000
    }
    handle /uploads/* {
        reverse_proxy server:3000
    }
    handle /docs* {
        reverse_proxy server:3000
    }
    redir /admin /admin/

    handle_path /admin/* {
        root * /srv/admin
        try_files {path} /index.html
        file_server
    }
    handle {
        root * /srv/h5
        try_files {path} /index.html
        file_server
    }
}
