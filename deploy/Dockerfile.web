# 一个镜像同时构建两个前端，最后塞进 Caddy —— 免去共享卷的麻烦
ARG NPM_REGISTRY=https://registry.npmjs.org/

FROM node:22-alpine AS h5
ARG NPM_REGISTRY
WORKDIR /app
COPY h5/package*.json ./
RUN sed -i "s#https://registry.npmjs.org/#${NPM_REGISTRY}#g" package-lock.json \
  && npm config set registry "${NPM_REGISTRY}" \
  && npm ci
COPY h5/ ./
RUN npm run build

FROM node:22-alpine AS admin
ARG NPM_REGISTRY
WORKDIR /app
COPY admin/package*.json ./
RUN sed -i "s#https://registry.npmjs.org/#${NPM_REGISTRY}#g" package-lock.json \
  && npm config set registry "${NPM_REGISTRY}" \
  && npm ci
COPY admin/ ./
RUN npm run build

FROM caddy:2-alpine
COPY --from=h5    /app/dist /srv/h5
COPY --from=admin /app/dist /srv/admin
COPY deploy/Caddyfile /etc/caddy/Caddyfile
